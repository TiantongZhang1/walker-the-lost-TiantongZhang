"transitions": PackedFloat32Array(1),
"update": 1,
"values": [false]
}

[resource]
_data = {
&"RESET": SubResource("Animation_RESET"),
&"dead": SubResource("Animation_dead"),
&"falling": SubResource("Animation_falling"),
&"idle": SubResource("Animation_idle"),
&"rising": SubResource("Animation_rising"),
&"run": SubResource("Animation_run"),
&"swing": SubResource("Animation_swing")
}
