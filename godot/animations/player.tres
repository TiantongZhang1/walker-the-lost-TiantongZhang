; --- dead ------------------------------------------------------------------
; LOOP_NONE: death is not a cycle.
[sub_resource type="Animation" id="Animation_dead"]
resource_name = "dead"
length = 0.5
loop_mode = 0
step = 0.0833333
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Sprite2D:frame")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": [9]
}

; --- RESET -----------------------------------------------------------------
; The default pose. Godot gives this name a meaning: with Reset On Save the
; scene is saved as if seeked to it. Without it, a scene saved mid-swing
; keeps the swing. The sword tracks join it in Step 4.
[sub_resource type="Animation" id="Animation_RESET"]
resource_name = "RESET"
length = 0.0333333
loop_mode = 0
step = 0.0333333
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Sprite2D:frame")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": [6]
}

[resource]
_data = {
&"RESET": SubResource("Animation_RESET"),
&"dead": SubResource("Animation_dead"),
&"falling": SubResource("Animation_falling"),
&"idle": SubResource("Animation_idle"),
&"rising": SubResource("Animation_rising"),
&"run": SubResource("Animation_run")
}
