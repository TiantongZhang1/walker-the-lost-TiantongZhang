; Assignment 7 — the player's animation library.
;
; Written as resource TEXT, so every key is a number in a reviewable diff.
; CHANGE-BRIEF.md §4 fixes the cycle, §6 the phase table; the keys below come
; from those tables and never the other way round.
;
; TWO CLIPS, TWO MECHANISMS:
;
;   run    the CYCLE, and a RIG clip. Two legs cut off p2-run rotate about
;          the hip and the body bobs. It swaps no frames.
;   swing  the COMMITTING ACTION, and a SPRITE-SHEET frame clip. The body
;          cell steps windup -> live -> back, and the attack hitbox's live
;          window is a discrete track on the same timeline.
;
; `update = 1` is Animation.UPDATE_DISCRETE, `0` is UPDATE_CONTINUOUS.
; `loop_mode = 1` is LOOP_LINEAR, `0` is LOOP_NONE. Godot 3's boolean `loop`
; would load here without complaint and leave loop_mode at 0.

[gd_resource type="AnimationLibrary" load_steps=8 format=3 uid="uid://cq7a7lostanim"]

; --- run : the cycle, as a cutout rig ---------------------------------------
; length 0.250 s = ONE stride: stride_px 24 / SPEED 96. Effect C spawns one
; dust puff per stride, so the cycle and the dust share a clock and the
; planted foot and the puff under it are the same event.
;
; **One stride, not two, and the reason is the art.** p2-run has one planted
; foot and one trailing leg held off the ground; there is no second planted
; foot to cut out. A two-stride cycle would need art this project does not
; have. CHANGE-BRIEF.md §4 says so rather than implying a full run cycle.
;
; **The seam rule here is the CONTINUOUS one**, not the frame-track one: the
; value at t = 0 and at t = length must match on every interpolated track, or
; the wrap jumps. LegFront 0 -> 0, LegBack 22 -> 22, Rig y 0 -> 0.
;
; **The rotation range is measured, not chosen.** tools/make_sprites.py
; renders each leg at every degree from -34 to +34 and reports the band in
; which the foot never falls below row 29, the floor row every pose ends on:
; the planted leg may go -2 .. +34, the trailing leg -34 .. +34. Positive
; LIFTS the planted foot. The paper version of this had the sign backwards.
[sub_resource type="Animation" id="Animation_run"]
resource_name = "run"
length = 0.5
loop_mode = 1
step = 0.125
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Rig:position:y")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.125, 0.25, 0.375, 0.5),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1),
"update": 0,
"values": [0.0, -1.0, 0.0, -1.0, 0.0]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("Rig/Body:frame")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": [0]
}
tracks/2/type = "value"
tracks/2/imported = false
tracks/2/enabled = true
tracks/2/path = NodePath("Rig/SwordArm/Blade:visible")
tracks/2/interp = 1
tracks/2/loop_wrap = true
tracks/2/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": [false]
}

; --- swing : the committing action, as a sprite-sheet frame clip ------------
; CHANGE-BRIEF.md §6's phase table, in frames at 30 fps:
;
;   startup   frames 0-5    0.000 - 0.200   cell 5, windup. Locked.
;   active    frames 6-9    0.200 - 0.333   cell 6, live. Hitbox is LIVE.
;   recovery  frames 10-17  0.333 - 0.600   settles back. Still locked.
;   end       frame 18      0.600           cell 1, idle. Movement returns.
;
; The body cells are p6-windup and p7-live, generated for walker-ninja in
; 2026-10 and never used until now. The startup and active poses are real
; art, not frames invented for this assignment.
[sub_resource type="Animation" id="Animation_swing"]
resource_name = "swing"
length = 0.6
loop_mode = 0
step = 0.0333333
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("Rig/Body:frame")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.2, 0.4, 0.6),
"transitions": PackedFloat32Array(1, 1, 1, 1),
"update": 1,
"values": [5, 6, 5, 1]
}
tracks/1/type = "value"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath("Hitbox:monitoring")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0, 0.2, 0.3333333),
"transitions": PackedFloat32Array(1, 1, 1),
"update": 1,
"values": [false, true, false]
}
tracks/2/type = "value"
tracks/2/imported = false
tracks/2/enabled = true
tracks/2/path = NodePath("Rig:position:y")
tracks/2/interp = 1
tracks/2/loop_wrap = true
tracks/2/keys = {
"times": PackedFloat32Array(0),
"transitions": PackedFloat32Array(1),
"update": 1,
"values": [0.0]
}
; Restored 2026-11-18 (r1), re-aimed the same day (r2). 0 degrees is the
; blade pointing straight UP out of the hand, positive is clockwise, which
; for a figure facing right is forward. Rig.scale.x mirrors the whole arm,
; so one set of keys is correct in both facings.
;
; r1's arc was -80 -> +85 -> +20, which REVERSED DIRECTION TWICE around a
; pivot 2 px above the waist: 330 degrees of travel in 0.6 s with the tip
; never below y = -3. The author played it and called it a sword spinning
; above the body, which is exactly what those numbers describe.
;
; r2 travels ONE WAY while the blade is visible -- clockwise from drawn-back
; through overhead to forward-and-LOW (+118, tip at y = +3, below the waist)
; -- and the 268-degree return to rest happens with the blade sheathed.
; CHANGE-BRIEF.md revision 7.0.2 holds the table.
tracks/3/type = "value"
tracks/3/imported = false
tracks/3/enabled = true
tracks/3/path = NodePath("Rig/SwordArm:rotation_degrees")
tracks/3/interp = 1
tracks/3/loop_wrap = true
tracks/3/keys = {
"times": PackedFloat32Array(0, 0.1333333, 0.2, 0.3333333, 0.4, 0.4333333, 0.6),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1, 1, 1),
"update": 0,
"values": [-150.0, -60.0, -50.0, 100.0, 115.0, 118.0, -150.0]
}
tracks/4/type = "value"
tracks/4/imported = false
tracks/4/enabled = true
tracks/4/path = NodePath("Rig/SwordArm/Blade:visible")
tracks/4/interp = 1
tracks/4/loop_wrap = true
tracks/4/keys = {
"times": PackedFloat32Array(0, 0.0666667, 0.4333333),
"transitions": PackedFloat32Array(1, 1, 1),
"update": 1,
"values": [false, true, false]
}
; r3, 2026-11-18. The HAND TRAVELS. r2 fixed which way the arc went and left
; the pivot nailed to one point -- and that point was x = +3, which the
; column profile of cell 6 says is the BACK EDGE of the torso: solid pixels
; per column jump from 17 at x = +2 to 23 at x = +3 and stay above 23 out to
; x = +13. The dense mass is +3..+15. So the hilt sat at the character's back
; and the blade pivoted about it like a clock hand. The author saw exactly
; that and said the centre belongs in FRONT.
;
; It does -- AT THE STRIKE. A wind-up pulls the hand back behind the
; shoulder; the strike drives it forward past the chest. So the pivot is
; keyed, not placed: (0,+2) sheathed at the hip, (3,-5) behind the shoulder
; at full cock, (13,+1) out in front on the last active frame. 10 px of
; forward travel on the hilt, under the same Rig.scale.x that mirrors
; everything else. CHANGE-BRIEF.md revision 7.0.3.
tracks/5/type = "value"
tracks/5/imported = false
tracks/5/enabled = true
tracks/5/path = NodePath("Rig/SwordArm:position")
tracks/5/interp = 1
tracks/5/loop_wrap = true
tracks/5/keys = {
"times": PackedFloat32Array(0, 0.1333333, 0.2, 0.3333333, 0.4, 0.4333333, 0.6),
"transitions": PackedFloat32Array(1, 1, 1, 1, 1, 1, 1),
"update": 0,
"values": [Vector2(0, 2), Vector2(2, -4), Vector2(3, -5), Vector2(13, 1), Vector2(12, 3), Vector2(12, 3), Vector2(0, 2)]
}

