[gd_resource type="ShaderMaterial" load_steps=4 format=3]

; CHANGE-BRIEF.md section 8, the dry column. Above the waterline: the mask is
; bound but switched out of the result, so this material shows what the stone
; looks like with no water in it at all.
;
; water_darkening = 0.0 removes the mask from ALBEDO entirely, and
; water_roughness = roughness_dry makes mix() return the same value either
; way, so ROUGHNESS is flat 0.85 across the surface. Both uniforms are still
; present and still drivable - this is a material difference, not a second
; shader.

[ext_resource type="Shader" path="res://shaders/dungeon_surface.gdshader" id="1_shader"]
[ext_resource type="Texture2D" path="res://assets/textures/stone_albedo.png" id="2_albedo"]
[ext_resource type="Texture2D" path="res://assets/textures/wetness_mask.png" id="3_mask"]

[resource]
resource_name = "stone_dry"
render_priority = 0
shader = ExtResource("1_shader")
shader_parameter/stone_albedo = ExtResource("2_albedo")
shader_parameter/wetness_mask = ExtResource("3_mask")
shader_parameter/tint = Color(1, 1, 1, 1)
shader_parameter/roughness_dry = 0.85
shader_parameter/water_darkening = 0.0
shader_parameter/water_roughness = 0.85
