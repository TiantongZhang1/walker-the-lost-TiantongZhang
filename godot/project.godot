[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="Hazard"
2d_physics/layer_5="Interactable"
2d_physics/layer_6="PlayerAttack"
2d_physics/layer_7="EnemyAttack"

[rendering]

textures/canvas_textures/default_texture_filter=0
; Stated explicitly although Forward+ is the engine default, so that
; project.godot NAMES its renderer. ProjectSettings.save() drops lines
; equal to the default, so the editor may remove these again.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.09, 0.08, 0.105, 1)
