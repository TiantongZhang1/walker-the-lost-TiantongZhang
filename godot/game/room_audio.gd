extends Node
## Gives the room a voice, by listening to signals that already exist.
##
## **It changes no game script.** `spike_trap.gd` and `player.gd` are not
## touched: this node connects to the `fired` and `died` signals they already
## emit and plays a sound. Presentation reads game state and never writes it,
## which is the same boundary `trap_warning_driver.gd` keeps.
##
## **The sounds are placeholders and say so.** `scripts/synth_placeholder_sfx.py`
## writes all four by arithmetic -- closed-form waveforms plus one noise array
## from numpy's PCG64 at seed 727001 -- so re-running it reproduces the WAVs
## byte for byte. They are NOT generated assets and do not satisfy any
## "generate sound" requirement; the script carried that disclaimer over from
## walker-ninja, where it was written, and it still applies.
##
## Two of the four are wired here. `sfx-jump` needs a signal `player.gd` does
## not emit, and adding one would mean editing a file Assignment 5's CLAUDE.md
## puts out of scope; `sfx-slash` belongs to a combat move this slice does not
## have. Both are left on disk rather than deleted, because the script that
## writes them writes four.

const SFX_TRAP: AudioStream = preload("res://assets/sfx-trap.ogg")
const SFX_DEATH: AudioStream = preload("res://assets/sfx-death.ogg")

## The bed. **Generated by Suno v6-mini on the free Basic tier, which means
## Suno retains ownership and the grant is personal and non-commercial.** A
## graded course submission and an unmonetised film are inside that grant; a
## monetised upload would not be. The full reasoning, the Help Center article
## it rests on and the date it was read are in `ATTRIBUTION.md`, carried from
## walker-ninja's `SOURCES.md` section 3 where the question was settled.
const MUSIC: AudioStream = preload("res://assets/music-loop.ogg")

## -14 dB under the effects. walker-ninja's CONCEPT revision 1.1 predicted
## that a 124 bpm bed with pulsing bass would mask a trap's warning and make
## a fair hazard read as unfair -- and this game's entire fairness argument
## is a 0.40 s warning window. Whether the bed masks the trap HERE is a
## human check with a human ear; the number below is a starting point, not a
## measurement, and `TEST-REPORT.md` records the verdict.
const MUSIC_DB := -14.0

## Three traps can fire close together, so the trap sound needs more than one
## voice or the second firing cuts the first off. One player per trap.
var _trap_voices: Array[AudioStreamPlayer] = []
var _next_voice := 0
var _death: AudioStreamPlayer
var _music: AudioStreamPlayer


func _ready() -> void:
	var traps := get_node_or_null(^"../Traps")
	if traps != null:
		for trap in traps.get_children():
			var voice := AudioStreamPlayer.new()
			voice.stream = SFX_TRAP
			voice.bus = &"Master"
			add_child(voice)
			_trap_voices.append(voice)
			if trap.has_signal(&"fired"):
				trap.fired.connect(_on_trap_fired)

	_death = AudioStreamPlayer.new()
	_death.stream = SFX_DEATH
	add_child(_death)
	var player := get_node_or_null(^"../Player")
	if player != null and player.has_signal(&"died"):
		player.died.connect(_on_player_died)

	# Headless uses a dummy audio driver, so this costs nothing there and
	# starting it unconditionally keeps one code path.
	_music = AudioStreamPlayer.new()
	_music.stream = MUSIC
	_music.volume_db = MUSIC_DB
	if _music.stream is AudioStreamOggVorbis:
		(_music.stream as AudioStreamOggVorbis).loop = true
	add_child(_music)
	_music.play()


func _on_trap_fired() -> void:
	if _trap_voices.is_empty():
		return
	_trap_voices[_next_voice].play()
	_next_voice = (_next_voice + 1) % _trap_voices.size()


func _on_player_died() -> void:
	_death.play()
